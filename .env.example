# Server-Side Gemini API Key (Automatically provisioned by AI Studio in Settings > Secrets)
GEMINI_API_KEY=

# Server Port (Defaults to 3000 in AI Studio environment)
PORT=3000

# Optional Open-Weights Endpoint (OpenAI-compatible server like Ollama, vLLM, DeepSeek, or Qwen)
# OPEN_SOURCE_LLM_BASE_URL=http://localhost:11434/v1
# OPEN_SOURCE_LLM_MODEL=qwen3:32b
# OPEN_SOURCE_LLM_API_KEY=
